# Daily Brief Configuration (YAML format)
#
# All URLs, credentials and API keys live in this file — never in code.
# Copy this file to daily-brief.yaml and fill in your values.
# The parser is strict: an unknown key (typo) is an error, not silently
# ignored. Keep the file mode 600 — it contains secrets.

# Mistral API (the LLM that drives the tools and writes the brief).
# Get a key at https://console.mistral.ai/
mistral:
  api_key: "YOUR_MISTRAL_API_KEY"
  model: "mistral-large-4"               # e.g. mistral-large-4, mistral-medium-latest, mistral-small-latest, ministral-8b-latest
  # base_url: "https://api.mistral.ai/v1"  # only override for proxies/tests
  temperature: 0.3                     # creativity; omit for the default (0.3), 0 = fully deterministic, max 2
  max_iterations: 12                   # max agent loop iterations per run

# The brief itself.
brief:
  language: "en"                       # "en" or "de"

# Prompts: the system prompt and the user prompt sent to the LLM.
# Available placeholders:
#   {date}     - today's date (YYYY-MM-DD)
#   {language} - the brief language (English/German)
#   {sources}  - generated list of the enabled sources and their tools
# When a prompt is empty, the built-in default is used.
prompts:
  system: |
    You are the user's personal assistant. Your job is to write a concise, visually appealing daily brief.
    Today's date: {date}.

    {sources}

    Rules:
    - Write the brief in {language}.
    - Use emojis and visual formatting to make the brief scannable and pleasant to read. The message is sent to Telegram with HTML formatting: make each section header bold with <b>...</b> (e.g. 📰 <b>Top news</b>) and keep the emojis. For the weather section, wrap the forecast in <pre>...</pre> to create a monospace table layout. Use no other markup — no Markdown (**bold**, *italic*, backticks), no HTML tables (Telegram does not support <table>), it would be shown literally. Outside <b> and <pre> tags, never write the characters <, > or & (write "and" instead of "&").
    - Structure the brief with exactly these sections, in this order, each with an emoji-prefixed header and a blank line before it:
      1. 📰 "Top news": sort the most important headlines into categories, each with an emoji-prefixed bold header. Use these categories (skip any that have no stories): 🏛️ <b>Politics</b>, 💶 <b>Economy</b>, ⚽ <b>Sports</b>, 🎭 <b>Culture</b>. Under each category, 1-2 bullet points (use ▪ or • as the bullet), one line each. Multiple sources often cover the same story — report each event only once, merging details from different sources into a single bullet. Never list the same news item twice. Total: 3-5 bullet points across all categories.
      2. 📧 "Emails": only noteworthy mails (skip newsletters, spam and automated notifications), one line each: sender — subject.
      3. ☀️ "PV system": current PV production, battery state of charge, and a one-line assessment (e.g. battery charging from solar, surplus feeding into the grid). Use ⚡ for production, 🔋 for battery.
      4. 🚗 "Car": the user's electric vehicle — battery state of charge, estimated range and charging status. Use 🔋 for the state of charge. When the data is more than a few hours old, mention that.
      5. 🐱 "Cats": for each cat, whether it is inside (🏠) or outside (🌳), and since when the location last changed. One line per cat.
      6. 🌤️ "Weather": a compact 7-day forecast in a monospace table inside <pre>...</pre> tags, one line per day. Columns: weather emoji, short day name and date, temperature range, precipitation, sunshine hours. Use · as a separator between columns. Examples:
         <pre>☀️ Mon 09 ·  8–17°C · 0.0mm · 5.2h sun
         🌧️ Tue 10 ·  9–15°C · 2.3mm (80%)
         ⛅ Wed 11 · 10–16°C · 0.5mm (20%) · 3.1h sun</pre>
         Weather emojis: ☀️ clear, 🌤️ mostly sunny, ⛅ partly cloudy, ☁️ overcast, 🌧️ rain, 🌦️ showers, ❄️ snow, ⛈️ thunderstorm, 🌫️ fog. Only show the precipitation probability when it is above 0%. Only show sunshine hours when above 0.
      7. 📺 "TV news": the coming day's late news editions from the get_tv_news_schedule tool, as a compact monospace block inside <pre>...</pre> tags — ready to copy and paste, like the weather table. One line per edition. Use · as a separator between columns: start–end time (HH:MM–HH:MM), channel (ZDF / ARD), show name (heute journal / tagesthemen). Mark an edition that starts within the configured window with a trailing ⏰. Omit editions the tool reports as not scheduled that day. If no edition starts within the window, write one line after the block suggesting to re-watch heute (19:00) in the ZDF Mediathek. Example:
         <pre>21:30–22:00 · ZDF · heute journal ⏰
         23:30–00:00 · ARD · tagesthemen</pre>
      8. 🔮 End with a single-sentence outlook for the day, based only on the weather forecast.
    - Separate sections with a blank line. You may use a thin separator line (e.g. ───) between major sections if it improves readability.
    - Keep the whole brief under 300 words. Be concise and factual.
    - Only report information the tools actually returned. Never invent news, emails or measurements.
    - When you have gathered enough information, reply with the final brief as your message and make no further tool calls.
  user: |
    Generate today's daily brief (date: {date}). Use your tools to gather the information first, then write the final brief as your reply.

# Sources for the brief.
sources:
  # Web pages: fetched and summarized as "Top news".
  # Note: zeit.de uses bot protection on the main site; the RSS feed on
  # newsfeed.zeit.de is accessible and returns the same headlines.
  web:
    - name: "Zeit Online"
      url: "https://newsfeed.zeit.de/index"
    - name: "Spiegel Online"
      url: "https://www.spiegel.de/"
    - name: "taz"
      url: "https://www.taz.de/rss.xml"
    - name: "WELT"
      url: "https://www.welt.de/feeds/topnews.rss"

  # Posteo mailbox: report mails that arrived within the last `since_hours`.
  # Posteo requires an APP PASSWORD for mail clients:
  # posteo.de → Settings → "Password and security" → "App passwords".
  email:
    enabled: true
    host: "posteo.de"                  # IMAP server
    port: 993                          # IMAP over TLS
    username: "you@posteo.de"          # your full Posteo address
    password: "YOUR_POSTEO_APP_PASSWORD"
    mailbox: "INBOX"
    since_hours: 24                    # report mails from the last 24h (keep >= the interval between runs).
                                       # Note: IMAP SINCE matches by calendar date only, so at the 05:00
                                       # run this effectively covers everything since yesterday 00:00.
    max_messages: 25                   # cap on mails per run (newest kept)

  # In-house SMA PV system (battery state + current production).
  # Speaks SMA Speedwire (UDP) natively — no external exporter needed.
  # Point `host` at your battery/hybrid inverter (Sunny Boy Storage,
  # Sunny Island, Sunny Tripower Smart Energy, ...); SMA Energy Meter /
  # Sunny Home Manager 2.0 are picked up too (they broadcast their values).
  # `password` is the inverter's user password (max 12 characters;
  # SMA's factory default is "0000"). With no `host`, devices are
  # discovered on the LAN; `serial` selects one by serial number.
  sma:
    enabled: true
    host: "192.168.1.50"               # IP or hostname of the inverter (empty = discover)
    password: "YOUR_SMA_USER_PASSWORD" # default: "0000"
    # serial: 1902000001               # optional: select discovered device by serial
    # interface: "eth0"                # optional: local interface for Speedwire multicast
    timeout_seconds: 30

  # Weather forecast for the coming days (Open-Meteo — free, no API key).
  # Get your coordinates from e.g. https://www.latlong.net/
  weather:
    enabled: true
    latitude: 52.5200                  # your location (example: Berlin)
    longitude: 13.4050
    timezone: "Europe/Berlin"          # optional; the location's timezone when empty
    days: 7                            # forecast days (max 16)
    # url: "https://api.open-meteo.com/v1/forecast"  # only override for proxies/tests
    timeout_seconds: 15

  # Electric vehicle (VW group: VW ID models, Audi, Skoda, Seat, Cupra).
  # Reads battery state of charge, range and charging status from the VW
  # group "EU Data Act" portal (https://eu-data-act.drivesomethinggreater.com)
  # — the same source evcc's "drivesomethinggreater" vehicle type uses, since
  # VW retired third-party access to the WeConnect app API.
  # Prerequisite (one-time, in a browser): log in at the portal with your
  # Volkswagen ID, confirm the consent screen, link the vehicle and enable
  # the continuous data request (every 15 minutes). Without this the portal
  # returns no data. The portal only delivers data while the car is active
  # (driving or charging), so the values may be hours old.
  ev:
    enabled: true
    brand: "Volkswagen"                # Volkswagen, Audi, Skoda, Seat or Cupra
    user: "you@example.com"            # your Volkswagen ID (email)
    password: "YOUR_VW_ID_PASSWORD"
    # vin: "WVWZZZ..."                 # optional: select the vehicle by VIN (first linked vehicle when empty)
    timeout_seconds: 30
    # portal_url: "https://eu-data-act.drivesomethinggreater.com"  # only override for proxies/tests
    # identity_url: "https://identity.vwgroup.io"                  # only override for proxies/tests

  # TV news: check the coming day's program of ARD (Das Erste) and ZDF — do
  # the late news editions heute-journal (ZDF) and tagesthemen (Das Erste)
  # start early, within the configured window? If an edition starts inside
  # the window, the brief lists it; otherwise it suggests re-watching heute
  # (19:00) in the ZDF Mediathek. Uses the public program APIs of ARD
  # (programm-api.ard.de) and ZDF (api.zdf.de) — free, no account needed.
  tv:
    enabled: true
    window_start: "21:15"                # report editions starting from here ...
    window_end: "21:30"                  # ... to here (both inclusive)
    timezone: "Europe/Berlin"            # the channels' program day
    timeout_seconds: 15
    # ard_url: "https://programm-api.ard.de"  # only override for proxies/tests
    # zdf_url: "https://api.zdf.de"           # only override for proxies/tests
    # zdf_api_key: "..."                      # only override; the default is the public token from ZDF's web player

  # Cats: inside/outside location of your cats, tracked by your SureFlap cat
  # flap (Connect line: Cat Flap Connect + Sure Petcare Hub) via the Sure
  # Petcare cloud API (unofficial, reverse-engineered — the same API the
  # Sure Petcare app and Home Assistant's surepetcare integration use; the
  # client is the gosure Go library). Use your Sure Petcare account
  # credentials (the app login).
  pets:
    enabled: true
    email: "you@example.com"             # your Sure Petcare account email
    password: "YOUR_SUREPETCARE_PASSWORD"

# Delivery: the brief is sent to this Telegram chat (and printed to stdout).
# Create a bot via @BotFather; get the chat id from
# https://api.telegram.org/bot<token>/getUpdates
telegram:
  token: "YOUR_TELEGRAM_BOT_TOKEN"
  chat_id: "YOUR_CHAT_ID"

# Web page fetching limits.
web_fetch:
  max_chars: 8000                      # max extracted text per page
  timeout_seconds: 15
