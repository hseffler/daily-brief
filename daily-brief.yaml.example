# Daily Brief Configuration (YAML format)
#
# All URLs, credentials and API keys live in this file — never in code.
# Copy this file to daily-brief.yaml and fill in your values.

# Mistral API (the LLM that drives the tools and writes the brief).
# Get a key at https://console.mistral.ai/
mistral:
  api_key: "YOUR_MISTRAL_API_KEY"
  model: "mistral-large-4"               # e.g. mistral-large-4, mistral-medium-latest, mistral-small-latest, ministral-8b-latest
  # base_url: "https://api.mistral.ai/v1"  # only override for proxies/tests
  temperature: 0.3                     # creativity; 0 means "use default"
  max_iterations: 12                   # max agent loop iterations per run

# The brief itself.
brief:
  language: "en"                       # "en" or "de"

# Prompts: the system prompt and the user prompt sent to the LLM.
# Available placeholders:
#   {date}     - today's date (YYYY-MM-DD)
#   {language} - the brief language (English/German)
#   {sources}  - generated list of the enabled sources and their tools
# When a prompt is empty, the built-in default is used.
prompts:
  system: |
    You are the user's personal assistant. Your job is to write a concise, visually appealing daily brief.
    Today's date: {date}.

    {sources}

    Rules:
    - Write the brief in {language}.
    - Use emojis and visual formatting to make the brief scannable and pleasant to read. The message is sent to Telegram with HTML formatting: make each section header bold with <b>...</b> (e.g. 📰 <b>Top news</b>) and keep the emojis. Use no other markup — no Markdown (**bold**, *italic*, backticks), it would be shown literally. Outside <b> tags, never write the characters <, > or & (write "and" instead of "&").
    - Structure the brief with exactly these sections, in this order, each with an emoji-prefixed header and a blank line before it:
      1. 📰 "Top news": 3-5 bullet points (use ▪ or • as the bullet), one line each, with the most important headlines from the web sources. Multiple sources often cover the same story — report each event only once, merging details from different sources into a single bullet. Never list the same news item twice.
      2. 📧 "Emails": only noteworthy mails (skip newsletters, spam and automated notifications), one line each: sender — subject.
      3. ☀️ "PV system": current PV production, battery state of charge, and a one-line assessment (e.g. battery charging from solar, surplus feeding into the grid). Use ⚡ for production, 🔋 for battery.
      4. 🌤️ "Weather": a compact 7-day forecast, one line per day. Start each line with a weather emoji, then the short day name and date, temperature range, and precipitation. Use · as a separator. Examples:
         ☀️ Mon 09 ·  8–17°C · 0.0mm
         🌧️ Tue 10 ·  9–15°C · 2.3mm (80%)
         ⛅ Wed 11 · 10–16°C · 0.5mm (20%)
         Weather emojis: ☀️ clear, 🌤️ mostly sunny, ⛅ partly cloudy, ☁️ overcast, 🌧️ rain, 🌦️ showers, ❄️ snow, ⛈️ thunderstorm, 🌫️ fog. Only show the precipitation probability when it is above 0%.
      5. 🔮 End with a single-sentence outlook for the day, based only on the weather forecast.
    - Separate sections with a blank line. You may use a thin separator line (e.g. ───) between major sections if it improves readability.
    - Keep the whole brief under 300 words. Be concise and factual.
    - Only report information the tools actually returned. Never invent news, emails or measurements.
    - When you have gathered enough information, reply with the final brief as your message and make no further tool calls.
  user: |
    Generate today's daily brief (date: {date}). Use your tools to gather the information first, then write the final brief as your reply.

# Sources for the brief.
sources:
  # Web pages: fetched and summarized as "Top news".
  # Note: zeit.de uses bot protection on the main site; the RSS feed on
  # newsfeed.zeit.de is accessible and returns the same headlines.
  web:
    - name: "Zeit Online"
      url: "https://newsfeed.zeit.de/index"
    - name: "Spiegel Online"
      url: "https://www.spiegel.de/"
    - name: "taz"
      url: "https://www.taz.de/rss.xml"
    - name: "WELT"
      url: "https://www.welt.de/feeds/topnews.rss"

  # Posteo mailbox: report mails that arrived within the last `since_hours`.
  # Posteo requires an APP PASSWORD for mail clients:
  # posteo.de → Settings → "Password and security" → "App passwords".
  email:
    enabled: true
    host: "posteo.de"                  # IMAP server
    port: 993                          # IMAP over TLS
    username: "you@posteo.de"          # your full Posteo address
    password: "YOUR_POSTEO_APP_PASSWORD"
    mailbox: "INBOX"
    since_hours: 24                    # report mails from the last 24h (keep >= the interval between runs)
    max_messages: 25                   # cap on mails per run (newest kept)

  # In-house SMA PV system (battery state + current production).
  # Speaks SMA Speedwire (UDP) natively — no external exporter needed.
  # Point `host` at your battery/hybrid inverter (Sunny Boy Storage,
  # Sunny Island, Sunny Tripower Smart Energy, ...); SMA Energy Meter /
  # Sunny Home Manager 2.0 are picked up too (they broadcast their values).
  # `password` is the inverter's user password (max 12 characters;
  # SMA's factory default is "0000"). With no `host`, devices are
  # discovered on the LAN; `serial` selects one by serial number.
  sma:
    enabled: true
    host: "192.168.1.50"               # IP or hostname of the inverter (empty = discover)
    password: "YOUR_SMA_USER_PASSWORD" # default: "0000"
    # serial: 1902000001               # optional: select discovered device by serial
    # interface: "eth0"                # optional: local interface for Speedwire multicast
    timeout_seconds: 30

  # Weather forecast for the coming days (Open-Meteo — free, no API key).
  # Get your coordinates from e.g. https://www.latlong.net/
  weather:
    enabled: true
    latitude: 52.5200                  # your location (example: Berlin)
    longitude: 13.4050
    timezone: "Europe/Berlin"          # optional; the location's timezone when empty
    days: 7                            # forecast days (max 16)
    # url: "https://api.open-meteo.com/v1/forecast"  # only override for proxies/tests
    timeout_seconds: 15

# Delivery: the brief is sent to this Telegram chat (and printed to stdout).
# Create a bot via @BotFather; get the chat id from
# https://api.telegram.org/bot<token>/getUpdates
telegram:
  token: "YOUR_TELEGRAM_BOT_TOKEN"
  chat_id: "YOUR_CHAT_ID"

# Web page fetching limits.
web_fetch:
  max_chars: 8000                      # max extracted text per page
  timeout_seconds: 15
